# Production env vars — Render dashboard'a set edilecekler.
# BU DOSYAYI COMMIT ETME — sadece örnek. Gerçek değerler Render'da.
#
# Nasıl güvenli değer üretilir:
#   openssl rand -hex 32       → CBT_HASH_SALT, CBT_ADMIN_TOKEN
#   openssl rand -base64 24    → DB password (Render zaten üretir)

# ============================================================
# LLM (Anthropic)
# ============================================================
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CBT_LLM_PROVIDER=anthropic
CBT_MODEL_COMPOSER=claude-sonnet-4-6
CBT_MODEL_INTENT=claude-haiku-4-5-20251001
CBT_MODEL_CRITIC=claude-haiku-4-5-20251001

# ============================================================
# Database — Render dashboard otomatik populate eder
# ============================================================
# CBT_DB_URL Render Postgres'ten otomatik bağlanır (render.yaml sync)
# Manuel format örneği:
# CBT_DB_URL=postgresql+psycopg://cbt:PASSWORD@dpg-xxxxxx-a.frankfurt-postgres.render.com/cbt

# ============================================================
# Session + KVKK
# ============================================================
CBT_HASH_SALT=CHANGE_ME_openssl_rand_hex_32
CBT_SESSION_TTL_SECONDS=3600
CBT_POLICY_VERSION=0.2

# ============================================================
# Admin (eval + safety cards için)
# ============================================================
CBT_ADMIN_TOKEN=CHANGE_ME_openssl_rand_hex_32

# ============================================================
# CORS (frontend origin'i)
# ============================================================
# Vercel deploy sonrası buraya URL'i ekle:
# CBT_CORS_ORIGINS=https://cbt-destek.tr,https://www.cbt-destek.tr
# Multi-origin virgülle ayır.
CBT_CORS_ORIGINS=https://cbt-destek.tr

# ============================================================
# Logging
# ============================================================
LOG_LEVEL=INFO

# ============================================================
# Embedding backend
# ============================================================
# 0 = TF-IDF (varsayılan, MVP için daha iyi)
# 1 = sentence-transformers (image büyür + latency artar)
CBT_PREFER_ST=0

# ============================================================
# Frontend (Vercel'e ayrı set edilir, backend'e değil)
# ============================================================
# NEXT_PUBLIC_API_BASE=https://cbt-api.onrender.com
